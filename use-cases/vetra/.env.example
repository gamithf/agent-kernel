# Choose ONE provider below:

# --- Groq (free, recommended) ---
# Get key at https://console.groq.com
OPENAI_API_KEY=gsk_your_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
VETRA_MODEL=llama-3.3-70b-versatile

# --- Standard OpenAI ---
# OPENAI_API_KEY=sk-your_openai_key_here
# VETRA_MODEL=gpt-4o

# --- GitHub Models (free with GitHub token) ---
# OPENAI_API_KEY=ghp_your_github_token
# OPENAI_BASE_URL=https://models.github.ai/inference/v1
# VETRA_MODEL=openai/gpt-4o

# --- WhatsApp (optional - only for full WhatsApp mode) ---
# AK_WHATSAPP__VERIFY_TOKEN=your_random_token
# AK_WHATSAPP__ACCESS_TOKEN=your_whatsapp_token
# AK_WHATSAPP__PHONE_NUMBER_ID=your_phone_number_id
